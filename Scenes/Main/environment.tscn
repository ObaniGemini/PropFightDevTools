[sub_resource type="Shader" id="Shader_k1yrl"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;
uniform sampler2D dithering : repeat_enable;
uniform float dither : hint_range(0.0, 1.0, 0.001);

const float rate = 5.0;
const vec2 DITHER_RES = vec2(1280.0, 720.0);
const vec2 BASE_PIXEL_SIZE = vec2(1.0)/DITHER_RES;

void fragment() {
	float t = floor(TIME * rate);
	float dist = distance(vec2(0.5, 0.5), SCREEN_UV);
	float factor = 1.05 - dist * dist;

	// vignette
	COLOR.rgb = texture(screen_texture, SCREEN_UV).rgb;
	COLOR.rgb *= factor;
	
	// dither
	const vec2 dither_pixel_size = BASE_PIXEL_SIZE / SCREEN_PIXEL_SIZE;
	//vec2 pos_ign = SCREEN_UV / SCREEN_PIXEL_SIZE;
	vec2 pos_white = SCREEN_UV * dither_pixel_size + vec2(cos(t * 151.0));
	
	COLOR.rgb += (/*mod(52.9829189 * mod(0.06711056 * pos_ign.x + 0.00583715 * pos_ign.y, 1.0), 1.0) +*/
					texture(dithering, pos_white).r - 0.5) * dither * factor;

	//desaturate
	//vec3 gray = vec3(dot(vec3(0.2126,0.7152,0.0722), COLOR.rgb));
	//COLOR.rgb = clamp(vec3(mix(COLOR.rgb, gray, (dist * dist))), vec3(0.0), vec3(1.0));
}
"

