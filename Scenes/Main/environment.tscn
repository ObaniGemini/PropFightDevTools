[sub_resource type="Shader" id="Shader_ovkpc"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;
uniform sampler2D noise : repeat_enable;

uniform float deform;
const float rate = 5.0;

global uniform float explosion;

float ign_noise(vec2 pos) {
	return mod(52.9829189 * mod(0.06711056 * pos.x + 0.00583715 * pos.y, 1.0), 1.0) - 0.5;
}

void fragment() {
	float t = floor(TIME * rate);
	vec3 p = texture(noise, 0.5 + 0.5 * vec2(cos(SCREEN_UV.x + t * 0.17), sin(SCREEN_UV.y + t * 0.25))).rgb;
	vec2 pos_ign = SCREEN_UV / SCREEN_PIXEL_SIZE;
	vec2 DEFORM = SCREEN_UV + (vec2(p.r - 0.5, p.b + p.g - 1.5) * deform + ign_noise(pos_ign) * explosion * 0.1);
	COLOR.rgb = texture(screen_texture, vec2(clamp(DEFORM.x, 0.0, 1.0), clamp(DEFORM.y, 0.0, 1.0))).rgb;
}
"

[sub_resource type="FastNoiseLite" id="FastNoiseLite_so7vx"]

